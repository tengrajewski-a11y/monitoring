# Przykładowa konfiguracja Nginx jako reverse proxy przed aplikacją Next.js.
# Podmień `twojadomena.pl` na swoją domenę i skopiuj do:
#   /etc/nginx/sites-available/trinity-trust-monitoring
# a następnie:
#   sudo ln -s /etc/nginx/sites-available/trinity-trust-monitoring /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# SSL (HTTPS) najprościej dodać przez certbot (Let's Encrypt) — patrz README.

server {
    listen 80;
    listen [::]:80;
    server_name twojadomena.pl www.twojadomena.pl;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Wymagane dla strumieniowania odpowiedzi (App Router) — patrz self-hosting.md w Next.js:
        proxy_set_header X-Accel-Buffering no;
        proxy_buffering off;
    }

    client_max_body_size 30m; # zgodnie z limitem uploadu audio do transkrypcji
}
