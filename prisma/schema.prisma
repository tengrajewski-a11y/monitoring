// Trinity Trust Corporate Counsel — Monitoring Legislacyjny i Medialny
// Prisma schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Rdzeń domenowy -------------------------------------------------------

/// Dziedzina / obszar tematyczny monitoringu (np. Energetyka i klimat)
model Domain {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  color       String   @default("#111111")
  icon        String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  keywords     DomainKeyword[]
  items        ItemDomain[]
  clientDomains ClientDomain[]
}

/// Słowa kluczowe użyte do automatycznej klasyfikacji dokumentów do dziedziny
model DomainKeyword {
  id       String @id @default(cuid())
  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  term     String

  @@unique([domainId, term])
  @@index([term])
}

/// Klient agencji public affairs (przygotowanie pod przyszły portal kliencki)
model Client {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  domains ClientDomain[]
  users   User[]
}

/// Powiązanie klient <-> dziedziny, które go interesują
model ClientDomain {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([clientId, domainId])
}

/// Użytkownik (na start: zespół agencji; w kolejnym etapie także klienci)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      UserRole @default(AGENCY)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now())
}

enum UserRole {
  AGENCY
  CLIENT
  ADMIN
}

// --- Monitoring legislacyjny ----------------------------------------------

enum SourceType {
  SEJM
  RCL
  EUR_LEX
  MEDIA
}

enum ItemKind {
  USTAWA
  ROZPORZADZENIE
  PROJEKT
  DYREKTYWA_UE
  ROZPORZADZENIE_UE
  KOMUNIKAT_UE
  WNIOSEK_UE
  ARTYKUL_MEDIALNY
  INNE
}

enum ItemStatus {
  NOWY
  W_TOKU
  PRZYJETY
  ODRZUCONY
  OPUBLIKOWANY
  WYCOFANY
  NIEZNANY
}

/// Pojedynczy monitorowany element: akt prawny / projekt / proces / publikacja
model MonitoringItem {
  id           String     @id @default(cuid())
  source       SourceType
  externalId   String
  kind         ItemKind   @default(INNE)
  status       ItemStatus @default(NIEZNANY)
  title        String
  summary      String?
  stage        String?
  institution  String?
  url          String
  documentDate DateTime?
  publishedAt  DateTime?
  updatedAt    DateTime   @updatedAt
  createdAt    DateTime   @default(now())
  raw          String? // surowy JSON z API źródłowego (debug/audyt)
  isFallback   Boolean    @default(false) // true = dane demo/seed, nie z API na żywo

  domains ItemDomain[]
  events  ItemEvent[]

  @@unique([source, externalId])
  @@index([source])
  @@index([documentDate])
  @@index([status])
}

/// Wiele-do-wielu: dokument <-> dziedziny (dokument może dotyczyć kilku dziedzin)
model ItemDomain {
  id       String @id @default(cuid())
  itemId   String
  item     MonitoringItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([itemId, domainId])
}

/// Historia etapów procesu legislacyjnego dla danego dokumentu
model ItemEvent {
  id        String   @id @default(cuid())
  itemId    String
  item      MonitoringItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  label     String
  date      DateTime?
  createdAt DateTime @default(now())
}

/// Log przebiegu synchronizacji z zewnętrznymi źródłami
model IngestionLog {
  id          String     @id @default(cuid())
  source      SourceType
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?
  status      String // "success" | "fallback" | "error"
  itemsFound  Int        @default(0)
  itemsNew    Int        @default(0)
  itemsUpdated Int       @default(0)
  errorMessage String?
}
