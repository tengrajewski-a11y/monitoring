# Connection string do bazy PostgreSQL (np. z Vercel Storage / Neon / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Wymagane do logowania — losowy sekret podpisujący sesje.
# Wygeneruj np. poleceniem: openssl rand -base64 32
AUTH_SECRET="zmien-mnie-na-losowy-ciag-znakow"

# Opcjonalnie: e-mail/hasło startowego konta administratora tworzonego przez
# `npm run db:seed`. Jeśli pominięte, e-mail to admin@trinity-trust.pl,
# a hasło zostanie wylosowane i wypisane w konsoli podczas seedowania.
# ADMIN_EMAIL="admin@twojafirma.pl"
# ADMIN_PASSWORD="ustaw-wlasne-haslo"

# Opcjonalny sekret zabezpieczający POST /api/ingest (np. do wywołania z crona)
# INGEST_SECRET="zmien-mnie"

# Opcjonalnie: włącza automatyczną transkrypcję (speech-to-text) posiedzeń
# komisji przez OpenAI Whisper API (zakładka Komisje). Bez tego klucza
# transkrypcję nadal można wpisać/wkleić ręcznie w panelu.
# OPENAI_API_KEY="sk-..."
# OPENAI_TRANSCRIBE_MODEL="whisper-1"
